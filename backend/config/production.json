{
  "app": {
    "name": "Conference Management System",
    "version": "1.0.0",
    "environment": "production",
    "debug": false
  },
  
  "server": {
    "host": "0.0.0.0",
    "port": 443,
    "ssl": true,
    "sslCert": "/etc/ssl/certs/conference.crt",
    "sslKey": "/etc/ssl/private/conference.key"
  },
  
  "database": {
    "host": "${DB_HOST}",
    "port": 5432,
    "name": "${DB_NAME}",
    "user": "${DB_USER}",
    "password": "${DB_PASSWORD}",
    "poolSize": 20,
    "maxPoolSize": 50,
    "timeout": 30
  },
  
  "jwt": {
    "secret": "${JWT_SECRET}",
    "algorithm": "HS256",
    "expiryHours": 24,
    "refreshExpiryDays": 30
  },
  
  "email": {
    "enabled": true,
    "smtp": {
      "host": "${SMTP_HOST}",
      "port": 587,
      "useSSL": false,
      "useTLS": true,
      "username": "${SMTP_USER}",
      "password": "${SMTP_PASSWORD}"
    },
    "from": {
      "email": "noreply@conference.local",
      "name": "Conference Management System"
    }
  },
  
  "file": {
    "uploadDir": "/var/conference/uploads",
    "maxFileSize": 52428800,
    "allowedTypes": "pdf,doc,docx,ppt,pptx,txt"
  },
  
  "logging": {
    "level": "error",
    "format": "json",
    "outputFile": "/var/log/conference/app.log",
    "maxFileSize": 10485760,
    "maxFiles": 20
  },
  
  "cors": {
    "enabled": true,
    "allowedOrigins": ["https://conference.example.com"],
    "allowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowedHeaders": ["Content-Type", "Authorization", "X-Request-ID"],
    "exposedHeaders": ["X-Total-Count", "X-Page-Number"],
    "allowCredentials": true,
    "maxAge": 86400
  },
  
  "pagination": {
    "defaultPageSize": 20,
    "maxPageSize": 100
  },
  
  "features": {
    "maintenanceMode": false,
    "maintenanceMessage": "System is under maintenance. Please try again later.",
    "enableNotifications": true,
    "enableFileUpload": true,
    "enableDoubleBlindReview": true
  }
}
