{
  "app": {
    "name": "Conference Management System",
    "version": "1.0.0",
    "environment": "development",
    "debug": true
  },
  
  "server": {
    "host": "localhost",
    "port": 8080,
    "ssl": false,
    "sslCert": "",
    "sslKey": ""
  },
  
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "conference_db",
    "user": "postgres",
    "password": "postgres",
    "poolSize": 5,
    "maxPoolSize": 20,
    "timeout": 30
  },
  
  "jwt": {
    "secret": "your-development-secret-key-change-in-production",
    "algorithm": "HS256",
    "expiryHours": 24,
    "refreshExpiryDays": 30
  },
  
  "email": {
    "enabled": true,
    "smtp": {
      "host": "localhost",
      "port": 587,
      "useSSL": false,
      "useTLS": true,
      "username": "noreply@localhost",
      "password": ""
    },
    "from": {
      "email": "noreply@conference.local",
      "name": "Conference System"
    }
  },
  
  "file": {
    "uploadDir": "./uploads",
    "maxFileSize": 52428800,
    "allowedTypes": "pdf,doc,docx,ppt,pptx,txt"
  },
  
  "logging": {
    "level": "debug",
    "format": "json",
    "outputFile": "./logs/app.log",
    "maxFileSize": 10485760,
    "maxFiles": 10
  },
  
  "cors": {
    "enabled": true,
    "allowedOrigins": ["http://localhost:3000"],
    "allowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowedHeaders": ["Content-Type", "Authorization", "X-Request-ID"],
    "exposedHeaders": ["X-Total-Count", "X-Page-Number"],
    "allowCredentials": true,
    "maxAge": 86400
  },
  
  "pagination": {
    "defaultPageSize": 20,
    "maxPageSize": 100
  },
  
  "features": {
    "maintenanceMode": false,
    "maintenanceMessage": "System is under maintenance. Please try again later.",
    "enableNotifications": true,
    "enableFileUpload": true,
    "enableDoubleBlindReview": true
  }
}
